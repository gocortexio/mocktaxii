# MockTAXII v1.1.4 Production Environment Template
# Copy this file to .env.prod for production deployment.
#
# Every variable listed here is read by the application, compose, or the
# production deployment script. Keep this file free of real credentials.

# --- Database -------------------------------------------------------------
# Required. The stack refuses to start without it.
POSTGRES_PASSWORD=your-secure-database-password-here

# --- Application security -------------------------------------------------
# Required in production: the app refuses to start when this is unset or left
# at a placeholder, because a predictable signing key lets anyone forge an
# authenticated admin session.
# Generate a value; leaving this blank deliberately makes production startup
# fail rather than publishing a signing key that can forge admin sessions.
#   openssl rand -base64 32
SESSION_SECRET=

# Optional. When unset, a password is generated at startup and written to
# /tmp/mocktaxii_admin_password inside the container. It is never logged.
# Retrieve it with:
#   docker compose -f deploy/docker-compose.prod.yml --env-file .env.prod \
#       exec web cat /tmp/mocktaxii_admin_password
# ADMIN_PASSWORD=

# Set to true ONLY when a trusted reverse proxy (the nginx or traefik service
# in docker-compose.prod.yml) terminates in front of the app. It makes the app
# honour X-Forwarded-*; enabling it without a proxy lets any client forge its
# own source address and bypass rate limiting.
TRUST_PROXY=true
# In local mode set this to false; there is no trusted proxy in front.

WTF_CSRF_ENABLED=true
FLASK_ENV=production

# --- Domain, proxy, and SSL ------------------------------------------------
# Set DOMAIN and PROXY=nginx for the included Nginx + host-certbot setup, or
# PROXY=traefik to let Traefik obtain and renew certificates itself. For a
# local deployment use DOMAIN=localhost and PROXY=local; that mode does not
# start a TLS proxy, serves the app on APP_PORT, and should use
# FLASK_ENV=development so HTTP session cookies work.
DOMAIN=
PROXY=nginx
APP_PORT=5000
LETSENCRYPT_EMAIL=

# --- Threat intelligence --------------------------------------------------
# 5000 (demo), 10000, 25000, 50000 (production), 100000 (large-scale).
# 50,000 takes roughly 10 seconds to generate.
MALICIOUS_IP_TARGET_COUNT=50000

# Skip seeding entirely (tables are still created).
SKIP_SEEDING=false

# --- Retention ------------------------------------------------------------
# request_log gains a row on every authenticated TAXII request. Pruned at most
# hourly by the healthcheck. Set to 0 to disable pruning and keep everything.
REQUEST_LOG_RETENTION_DAYS=90

# --- Logging --------------------------------------------------------------
LOG_LEVEL=INFO

# --- Database connection pool ---------------------------------------------
# gunicorn runs gthread with 2 workers x 4 threads, so up to 8 concurrent
# requests. Keep pool_size at or above that.
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=300
